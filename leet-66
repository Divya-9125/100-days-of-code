class Solution {
    public int[] plusOne(int[] digits) {
        for(int i=digits.length-1;0<=i;i--){
            if(digits[i]==9){
                digits[i]=0;
            }
            else{
                digits[i]+=1;
                return digits;
            }
        }
        int[] ans=new int[digits.length+1];
        ans[0]=1;
        for(int i=1;i<ans.length;i++){
            ans[i]=digits[i-1];
        }
        return ans;
    }
}
